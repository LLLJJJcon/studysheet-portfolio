# Copy this file to .env and fill in real values.
# .env is loaded by docker-compose (server service) and by the server at runtime.

# Required by server
JWT_SECRET=change-me-use-a-long-random-string
ENCRYPTION_KEY=change-me-32-chars-minimum-xxxxx

# Optional: uncomment if you run the server locally (outside Docker)
# MONGODB_URI=mongodb://localhost:27017/studysheet
# PORT=3001
# NODE_ENV=development
